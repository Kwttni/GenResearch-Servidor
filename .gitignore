# ==========================================
# 1. AMBIENTE VIRTUAL E CACHE DO PYTHON
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.bak/
venv.bak/

# ==========================================
# 2. DADOS DE TESTE, BANCOS E DATASETS PESADOS
# (Exigência de artefatos e limites do GitHub)
# ==========================================
dados_teste/*.bin
dataset/*.csv
*.db
*.sqlite3
*.sqldb
genresearch.db

# ==========================================
# 3. LOGS, CACHE E SAÍDAS DE EXECUÇÃO
# ==========================================
*.log
genresearch.log
graficos.log
andamento.log
*.tmp
*.swp

# ==========================================
# 4. CREDENCIAIS E SEGREDO (Item 3 do Roteiro)
# ==========================================
.env
.env.*
*.pem
*.key
*.token

# ==========================================
# 5. CONFIGURAÇÕES DA IDE E DO SISTEMA OPERACIONAL
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# 6. EXCEÇÕES / MANTIDOS NO REPOSITÓRIO
# ==========================================
# Mantém a estrutura das pastas mesmo que estejam sem arquivos de dados pesados
!dados_teste/.gitkeep
!dataset/.gitkeep
!resultados/.gitkeep